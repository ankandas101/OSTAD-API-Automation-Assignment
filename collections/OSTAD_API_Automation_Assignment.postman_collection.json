  "item": [
    {
      "name": "Q3-Login & Capture Token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.request.headers.has('x-api-key')) {",
              "    pm.request.headers.add({",
              "        key: 'x-api-key',",
              "        value: pm.environment.get('apiKey')",
              "    });",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Verify status code",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// 2. Convert response to JSON",
              "const resquestData = pm.response.json();",
              "",
              "// 3. Verify token exists",
              "",
              "pm.test(\"Login response should contain auth token\", function () {",
              "    pm.expect(resquestData).to.have.property(\"token\");",
              "    pm.expect(resquestData.token).to.be.a(\"string\");",
              "    pm.expect(resquestData.token.length).to.be.greaterThan(5);",
              "});",
              "",
              "// 4. Store token into environment variable",
              "pm.environment.set(\"authToken\", resquestData.token);",
              "",
              "// 5. Print token in Console",
              "console.log(\"Captured Auth Token:\", resquestData.token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"eve.holt@reqres.in\",\n    \"password\": \"cityslicka\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Q4 - GET User by userId",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set(\"userId\",10); //set the enviroment variable userID "
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Veify the satus code is 200",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const requestData = pm.response.json();",
              "",
              "//verify that user id is mached",
              "pm.test(\"Returned user ID should match variable\", function () {",
              "    pm.expect(requestData.data.id).to.eql(Number(pm.environment.get(\"userId\")));",
              "});",
              "",
              "//verify first Name for User id = 10",
              "pm.test(\"First name should be Byron\", function () {",
              "    pm.expect(requestData.data.first_name).to.eql(\"Byron\");",
              "});",
              "// verify the email address",
              "pm.test(\"Email should match expected value\", function () {",
              "    pm.expect(requestData.data.email)",
              "        .to.eql(\"byron.fields@reqres.in\");",
              "});",
              "",
              "// First Name and Email store in environment variables",
              "pm.environment.set(\"firstName\", requestData.data.first_name);",
              "pm.environment.set(\"email\", requestData.data.email);",
              "",
              "console.log(\"Stored First Name:\", requestData.data.first_name);",
              "console.log(\"Stored Email:\", requestData.data.email);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
