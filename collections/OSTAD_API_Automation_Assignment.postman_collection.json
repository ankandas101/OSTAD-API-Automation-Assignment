    {
      "name": "Q5 - PUT Updated Profile",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Status code validation",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const res = pm.response.json();",
              "",
              "// Verify updated name",
              "pm.test(\"Name should be updated\", function () {",
              "    pm.expect(res.name).to.eql(\"Ankan Das\");",
              "});",
              "",
              "// Verify updated job",
              "pm.test(\"Job should be updated\", function () {",
              "    pm.expect(res.job).to.eql(\"Jr QA Engineer\");",
              "});",
              "",
              "// Verify updatedAt exists",
              "pm.test(\"updatedAt timestamp should exist\", function () {",
              "    pm.expect(res.updatedAt).to.exist;",
              "});",
              "",
              "// Verify updatedAt is a valid ISO timestamp",
              "pm.test(\"updatedAt should be a valid ISO timestamp\", function () {",
              "    const date = new Date(res.updatedAt);",
              "",
              "    pm.expect(date.toISOString()).to.eql(res.updatedAt);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
